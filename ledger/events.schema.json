{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nomicon ledger event",
  "description": "One line of a ledger/events/YYYY-MM-DD.jsonl file. Type-specific fields are documented in ledger/README.md and will be tightened when the agent is built.",
  "type": "object",
  "required": ["id", "at", "type", "sig"],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "at": { "type": "integer", "minimum": 0 },
    "type": {
      "enum": ["genesis", "intake_reject", "screen_hold", "hold_resolved", "quote", "quote_lapsed", "payment", "vote_open", "review", "label", "challenge", "vote_close", "merge", "withdrawal", "expiry", "owner_confirm", "owner_reject", "fee_adjust", "takedown", "redaction", "patch", "deploy", "destination_change", "agent_account_change", "screen_deferred", "vote_queued", "key_rotation", "declare", "correction", "refusal", "laws_snapshot", "owner_action_applied", "channel", "notice", "digest", "world_direct"]
    },
    "sig": { "type": "string" }
  },
  "additionalProperties": true
}
